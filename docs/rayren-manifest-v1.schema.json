{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rayren Manifest v1",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "min_client_version": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "string", "format": "date-time"},
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {"oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 65536},
        {"type": "object", "required": ["uri"], "properties": {
          "uri": {"type": "string", "minLength": 1, "maxLength": 65536},
          "name": {"type": "string", "maxLength": 100},
          "region": {"type": "string", "maxLength": 32},
          "priority": {"type": "integer", "minimum": -100, "maximum": 100}
        }}
      ]}
    }
  }
}
